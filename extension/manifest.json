{
  "manifest_version": 3,
  "name": "FlowMap AI",
  "short_name": "FlowMap AI",
  "version": "0.1.0",
  "description": "AI-powered process documentation and workflow discovery. Local-first, privacy-by-default.",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "desktopCapture",
    "scripting",
    "webNavigation",
    "storage",
    "offscreen"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
